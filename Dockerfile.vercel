FROM composer:2 AS composer

FROM dunglas/frankenphp:1-php8.4-bookworm AS php-build

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev libicu-dev libzip-dev libonig-dev unzip \
    && docker-php-ext-install -j2 pdo_pgsql intl zip bcmath mbstring opcache \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/bin/composer

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --prefer-dist --no-interaction --no-progress --optimize-autoloader --no-scripts
COPY . .
RUN composer dump-autoload --no-dev --optimize --no-scripts \
    && php artisan package:discover --ansi

FROM node:22-alpine AS frontend

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY vite.config.js ./
COPY resources ./resources
COPY --from=php-build /app/vendor ./vendor
RUN npm run build

FROM dunglas/frankenphp:1-php8.4-bookworm AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 libicu72 libzip4 libonig5 \
    && rm -rf /var/lib/apt/lists/* \
    && setcap -r /usr/local/bin/frankenphp \
    && cp /usr/local/etc/php/php.ini-production /usr/local/etc/php/php.ini \
    && groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --create-home app

COPY --from=php-build /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-build /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

WORKDIR /app
COPY --chown=app:app --from=php-build /app /app
COPY --chown=app:app --from=frontend /app/public/build ./public/build
COPY docker/vercel/Caddyfile /etc/frankenphp/Caddyfile
COPY docker/vercel/php.ini /usr/local/etc/php/conf.d/zz-app.ini
RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && mkdir -p /config/caddy /data/caddy \
    && chown -R app:app /config/caddy /data/caddy \
    && chown -R app:app storage bootstrap/cache \
    && chmod +x docker/vercel/entrypoint.sh \
    && frankenphp validate --config /etc/frankenphp/Caddyfile --adapter caddyfile

ENV APP_ENV=production APP_DEBUG=false LOG_CHANNEL=stderr SESSION_DRIVER=database CACHE_STORE=database QUEUE_CONNECTION=sync

USER app
ENTRYPOINT ["/app/docker/vercel/entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]
